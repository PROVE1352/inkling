# Demo instance settings (restricted mode, 0.22; docs/DEMO.md). Copy to deploy/demo/demo.env, fill in the
# values marked CHANGE-ME, and run everything through the script, never plain `docker compose`:
#   deploy/demo/demo.sh config     # check what would run (project, volumes, database, port)
#   deploy/demo/demo.sh up
# This file replaces the production .env for the demo: nothing here is shared with the main instance.
# Keep the demo in a checkout of its own, not in the production instance's folder (docs/DEMO.md).

# --- Separate instance: project, network, volumes, database ------------------------------------------
# The compose project (inkling-demo), the volumes (inkling-demo_db, _data, _backups, _backup-ctl), the
# network and the database role and name (inkling_demo) are fixed in compose.demo.yaml and demo.sh; no
# variable here or in the shell changes them.
# A new password for the demo database, never production's: openssl rand -base64 32
DEMO_POSTGRES_PASSWORD=CHANGE-ME-openssl-rand-base64-32
# compose.yaml (the base file) needs these two to read at all; the overlay replaces every place they
# are used with the demo's own values. Leave them as they are (after DEMO_POSTGRES_PASSWORD).
INKLING_DATA_NAME=inkling_demo
POSTGRES_PASSWORD=${DEMO_POSTGRES_PASSWORD}
# On this machine only; a reverse proxy in front (docs/DEMO.md, "Proxy"). Not 3000 (production's default).
DEMO_PORT=127.0.0.1:3100
# The demo's own image name, never production's (ghcr.io/prove1352/inkling): `demo.sh up` builds it from
# this checkout when it is missing, `demo.sh build` rebuilds it after a `git pull`. A name without "demo"
# in it is refused, so a demo build or pull can never replace the image production's next `up` uses.
DEMO_IMAGE=inkling-demo:local
# Absolute path where the operator has mounted a filesystem made for the demo's data only, with its own
# size and inode limits (docs/DEMO.md, "A filesystem for the demo's data"). The database, uploads,
# backups and backup control files go in its db/, data/, backups/ and backup-ctl/ folders (demo.sh makes
# them). `up` refuses a path on the root filesystem (or on Docker's data folder's).
DEMO_VOLUME_ROOT=/srv/inkling-demo-data
# The public https address people will use, from the start (docs/DEMO.md, steps 1 and 4): until the
# operator account exists the server refuses every sign-up but the setup link's (SETUP_REQUIRED), and the
# setup link is built from this address. Forms posted from any other origin are refused.
PUBLIC_URL=https://demo.example.com
# Encrypts two-step verification secrets (>= 32 characters). A new one, never production's:
# openssl rand -base64 32
DEMO_APP_SECRET_KEY=CHANGE-ME-openssl-rand-base64-32
# The proxy's address range, so sign-up IP limits see the real client address.
TRUST_PROXY=loopback,uniquelocal
NODE_ENV=production

# --- Sign-up: IDs instead of emails, no key, no mail --------------------------------------------------
LOGIN_ID_MODE=username
SIGNUP_REQUIRE_KEY=0
SIGNUP_MAX_USERS=50
SIGNUP_PER_IP_PER_DAY=2
# Accounts made from now on are deleted 14 days after sign-up (admins never).
ACCOUNT_LIFETIME_DAYS=14
# 1 = only log which accounts would be deleted. Use it for the first days, then empty it (docs/DEMO.md).
ACCOUNT_LIFETIME_DRY_RUN=

# --- Limits --------------------------------------------------------------------------------------------
LIMIT_WORKSPACES_PER_USER=2
LIMIT_MEMBERS_PER_WORKSPACE=4
LIMIT_PAGES_PER_WORKSPACE=300
LIMIT_FILE_MB=5
# Files (each at least 5 KB), page bodies, version history and search indexes of one workspace (0.22.1:
# 10, measured so 100 full workspaces fit under the 3,000 MB fuse, docs/DEMO.md "Disk and the storage fuse").
LIMIT_WORKSPACE_STORAGE_MB=10
LIMIT_VERSIONS_PER_PAGE=10
# Trashed pages are deleted for good after 7 days, whatever a workspace sets (the privacy policy says so).
LIMIT_TRASH_DAYS=7
WORKSPACE_RESTORE_DAYS=7
AGENT_UPLOAD_MAX_MB=5
AGENT_UPLOAD_DAILY_MB=10
# Workspaces on the whole server (deleted but restorable ones included): bounds what one account can collect
# through ownership handed over when others delete their accounts.
LIMIT_WORKSPACES_TOTAL=100
# Storage fuse in MB (database + uploads, measured once a minute): at it the demo only reads and deletes.
LIMIT_INSTANCE_STORAGE_MB=3000

# --- Features turned off for the whole server ---------------------------------------------------------
DISABLED_FEATURES=public-links,public-forms,webhooks,slack,link-preview,web-clipper,ical,notion-import,web-push,password-reset,email-invites,automations-webhooks,oauth-cimd,embeds,member-direct-add

# --- Terms, privacy policy, sign-up consent, label ----------------------------------------------------
# Host folder mounted read-only at /legal (LEGAL_DIR). The template has placeholders; copy it, fill it in,
# and point this at the copy (docs/DEMO.md, "Terms folder").
DEMO_LEGAL_DIR=./deploy/demo/legal
INSTANCE_LABEL=Demo
# A notice on the sign-in and sign-up screens and above the app, for changes, outages and incidents (the
# demo sends no mail; the terms say notices appear here). Plain text, at most 500 characters, "\n" in
# double quotes is a line break. Empty = none.
INSTANCE_NOTICE=

# --- Off on the demo: mail, external sign-in, semantic search, experimental features ------------------
SMTP_HOST=
MAIL_FROM=
REQUIRE_EMAIL_VERIFICATION=
DELEGATED_AUTH_URL=
OIDC_ISSUER=
EMBEDDING_URL=
EMBEDDING_MODEL=
EXPERIMENTAL_FEATURES=
OAUTH_CIMD=
UPDATE_CHECK=

# --- Backups: 7 daily sets, no weekly or monthly sets (as the privacy policy says) --------------------
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=0
BACKUP_KEEP_MONTHLY=0
BACKUP_RCLONE_REMOTE=
# Only for remote copies (BACKUP_RCLONE_REMOTE). If you set one, a new passphrase, never production's:
# openssl rand -base64 32
DEMO_BACKUP_PASSPHRASE=

# --- Container limits ------------------------------------------------------------------------------------
# 0.22.1: heap 448 MB in a 768 MB container (measured: three accounts holding 2.5 MB pages open peaked at a
# 434 MB heap and 734 MB of RSS at 448 and ran out of memory at 320 and 384; docs/DEMO.md "Memory").
APP_MEM_LIMIT=768m
NODE_OPTIONS=--max-old-space-size=448
APP_CPUS=1.0
APP_PIDS_LIMIT=256
PG_MEM_LIMIT=384m
PG_SHARED_BUFFERS=96MB
PG_EFFECTIVE_CACHE_SIZE=256MB
PG_CPUS=1.0
PG_PIDS_LIMIT=256
BACKUP_CPUS=0.5
BACKUP_PIDS_LIMIT=128

# --- Added after the security review (contract §14) -----------------------------------------------
# Accounts the whole server makes in one hour (the setup link's account does not count).
SIGNUP_PER_HOUR=10
# Self-registered OAuth clients nothing ever used are deleted 24 hours after registering, and at most
# 500 of them are kept (a new registration removes the oldest, never one younger than 15 minutes).
OAUTH_UNUSED_CLIENT_HOURS=24
OAUTH_UNUSED_CLIENT_MAX=500
