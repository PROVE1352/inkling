{
  "name": "@inkling/server",
  "version": "0.19.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "node ../../scripts/run-tests.mjs",
    "test:db": "node ../../scripts/run-tests.mjs --db"
  },
  "dependencies": {
    "@blocknote/server-util": "0.51.4",
    "@fastify/cookie": "^11.0.0",
    "@fastify/multipart": "9.4.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "10.1.10",
    "@hocuspocus/extension-database": "^2.15.0",
    "@hocuspocus/server": "^2.15.0",
    "@inkling/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@node-rs/argon2": "^2.0.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "jszip": "^3.10.1",
    "nodemailer": "10.1.7",
    "postgres": "^3.4.0",
    "unpdf": "1.9.1",
    "ws": "^8.18.0",
    "yjs": "^13.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "drizzle-kit": "0.31.11",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
