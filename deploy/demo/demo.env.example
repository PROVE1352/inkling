# Demo instance settings (restricted mode, 0.22; docs/DEMO.md). Copy to deploy/demo/demo.env, fill in the
# values marked CHANGE-ME, and start with:
#   docker compose --env-file deploy/demo/demo.env -f compose.yaml -f deploy/demo/compose.demo.yaml up -d
# This file replaces the production .env for the demo: nothing here is shared with the main instance.

# --- Separate instance: project, network, volumes, database ------------------------------------------
INKLING_DEMO_PROJECT=inkling-demo
COMPOSE_PROJECT_NAME=inkling-demo
# Database role and name, and the second half of the volume names (inkling-demo_inkling_demo-db, ...)
INKLING_DATA_NAME=inkling_demo
POSTGRES_PASSWORD=CHANGE-ME-openssl-rand-base64-32
# On this machine only; a reverse proxy in front (docs/DEMO.md, "Proxy").
INKLING_PORT=127.0.0.1:3100
# The public https address people will use, from the start (docs/DEMO.md, steps 1 and 4): until the
# operator account exists the server refuses every sign-up but the setup link's (SETUP_REQUIRED), and the
# setup link is built from this address. Forms posted from any other origin are refused.
PUBLIC_URL=https://demo.example.com
# Encrypts two-step verification secrets (>= 32 characters, openssl rand -base64 32).
APP_SECRET_KEY=CHANGE-ME-openssl-rand-base64-32
# The proxy's address range, so sign-up IP limits see the real client address.
TRUST_PROXY=loopback,uniquelocal
NODE_ENV=production

# --- Sign-up: IDs instead of emails, no key, no mail --------------------------------------------------
LOGIN_ID_MODE=username
SIGNUP_REQUIRE_KEY=0
SIGNUP_MAX_USERS=50
SIGNUP_PER_IP_PER_DAY=2
# Accounts made from now on are deleted 14 days after sign-up (admins never).
ACCOUNT_LIFETIME_DAYS=14
# 1 = only log which accounts would be deleted. Use it for the first days, then empty it (docs/DEMO.md).
ACCOUNT_LIFETIME_DRY_RUN=

# --- Limits --------------------------------------------------------------------------------------------
LIMIT_WORKSPACES_PER_USER=2
LIMIT_MEMBERS_PER_WORKSPACE=4
LIMIT_PAGES_PER_WORKSPACE=300
LIMIT_FILE_MB=5
LIMIT_WORKSPACE_STORAGE_MB=20
LIMIT_VERSIONS_PER_PAGE=10
# Trashed pages are deleted for good after 7 days, whatever a workspace sets (the privacy policy says so).
LIMIT_TRASH_DAYS=7
WORKSPACE_RESTORE_DAYS=7
AGENT_UPLOAD_MAX_MB=5
AGENT_UPLOAD_DAILY_MB=10

# --- Features turned off for the whole server ---------------------------------------------------------
DISABLED_FEATURES=public-links,public-forms,webhooks,slack,link-preview,web-clipper,ical,notion-import,web-push,password-reset,email-invites,automations-webhooks,oauth-cimd,embeds,member-direct-add

# --- Terms, privacy policy, sign-up consent, label ----------------------------------------------------
# Host folder mounted read-only at /legal (LEGAL_DIR). The template has placeholders; copy it, fill it in,
# and point this at the copy (docs/DEMO.md, "Terms folder").
DEMO_LEGAL_DIR=./deploy/demo/legal
INSTANCE_LABEL=Demo
# A notice on the sign-in and sign-up screens and above the app, for changes, outages and incidents (the
# demo sends no mail; the terms say notices appear here). Plain text, at most 500 characters, "\n" in
# double quotes is a line break. Empty = none.
INSTANCE_NOTICE=

# --- Off on the demo: mail, external sign-in, semantic search, experimental features ------------------
SMTP_HOST=
MAIL_FROM=
REQUIRE_EMAIL_VERIFICATION=
DELEGATED_AUTH_URL=
OIDC_ISSUER=
EMBEDDING_URL=
EMBEDDING_MODEL=
EXPERIMENTAL_FEATURES=
OAUTH_CIMD=
UPDATE_CHECK=

# --- Backups: 7 daily sets, no weekly or monthly sets (as the privacy policy says) --------------------
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=0
BACKUP_KEEP_MONTHLY=0
BACKUP_RCLONE_REMOTE=
BACKUP_PASSPHRASE=

# --- Container limits ------------------------------------------------------------------------------------
APP_MEM_LIMIT=512m
NODE_OPTIONS=--max-old-space-size=320
APP_CPUS=1.0
APP_PIDS_LIMIT=256
PG_MEM_LIMIT=384m
PG_SHARED_BUFFERS=96MB
PG_EFFECTIVE_CACHE_SIZE=256MB
PG_CPUS=1.0
PG_PIDS_LIMIT=256
BACKUP_CPUS=0.5
BACKUP_PIDS_LIMIT=128
