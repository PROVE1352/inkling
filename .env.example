# Copy to .env. (Development defaults work without a .env; the Docker stack needs POSTGRES_PASSWORD.)
DATABASE_URL=postgres://inkling:inkling@localhost:55432/inkling
# Name of the Docker stack's compose project, volumes, database role and database (compose.yaml).
# Required: keep `inkling` for a new install. A server that ran Inkling 0.18 or older uses `nodian`
# until it runs deploy/rename-from-nodian.sh; setting `inkling` there starts on new, empty volumes
# (docs/OPERATIONS.md "Upgrading to 0.19").
INKLING_DATA_NAME=inkling
# Database password for the Docker stack. Required: compose refuses to start without it.
# Generate one with `openssl rand -base64 24` before the first start; Postgres only reads it when it
# creates the data volume. (`pnpm db:up` for development falls back to `inkling`.)
POSTGRES_PASSWORD=
PORT=3001
DATA_DIR=./data
# Docker stack host ports (compose.yaml). INKLING_PORT: the app, a port or ip:port (default 3000; e.g.
# 127.0.0.1:3987 keeps it on this machine). INKLING_DB_PORT: the loopback-only database port (default
# 55432). For a local trial, ./deploy/local.sh writes its own .env instead of this file.
INKLING_PORT=
INKLING_DB_PORT=
# Public origin of this instance, e.g. https://notes.example.com. Used for mail links, the OAuth
# issuer (MCP) and share previews; an https:// value also turns on Secure cookies automatically.
PUBLIC_URL=
# 1 = Secure cookies. Only needed for an HTTPS setup without an https:// PUBLIC_URL.
COOKIE_SECURE=0
# Server key for secrets stored encrypted (two-step verification). At least 32 characters:
#   openssl rand -base64 32
# Empty → users cannot turn on two-step verification. Changing it later makes existing 2FA setups
# unreadable (those users sign in with a recovery code and set 2FA up again). Keep it out of backups.
APP_SECRET_KEY=
# Notion upload feature (create an internal integration at notion.so/my-integrations and paste its token)
NOTION_TOKEN=
# --- Delegated login (optional) ---
# When set, "delegated login" is on — logging in with an id Inkling doesn't know is verified by the
# external auth server at this URL (the contract it must follow is in deploy/DEPLOY.md). Coexists with
# Inkling's own accounts (created with signup keys) and works for login in one direction only — Inkling
# account passwords are never sent out.
# e.g. https://auth.example.com
DELEGATED_AUTH_URL=
# Name of the external account shown on the login and admin screens (default: "External account")
DELEGATED_AUTH_NAME=
# Fake email domain used to mirror delegated accounts into Inkling (<id>@<domain>, default delegated.local).
# Changing it on a live server breaks the match with existing delegated accounts, so keep the first value.
DELEGATED_EMAIL_DOMAIN=
# Require an Inkling signup key to register (1). Turned on automatically when DELEGATED_AUTH_URL is set.
# Issue a key: ./deploy/signup-key.sh new "friend A"
SIGNUP_REQUIRE_KEY=

# --- OpenID Connect sign-in (optional; deploy/DEPLOY.md "3-G", docs/adr/1160-*..1162-*) ---
# "Sign in with <OIDC_NAME>" on the login screen, for Google Workspace, Microsoft Entra ID, Keycloak,
# Authentik and other OpenID Connect providers. On when issuer, client id and secret are all set; needs
# PUBLIC_URL. Register this redirect URI at the provider: <PUBLIC_URL>/api/auth/oidc/callback
# e.g. https://accounts.google.com, https://login.microsoftonline.com/<tenant-id>/v2.0,
#      https://sso.example.com/realms/team (Keycloak), https://sso.example.com/application/o/inkling/ (Authentik)
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Kept out of logs and API responses. Keep it out of backups like APP_SECRET_KEY.
OIDC_CLIENT_SECRET=
# Button label: "Sign in with <name>" (default SSO)
OIDC_NAME=
# Only these email domains may sign in (comma-separated, e.g. example.com,example.org). Empty = anyone the provider issues.
OIDC_ALLOWED_DOMAINS=
# 1 = create an Inkling account on the first sign-in of someone new (no signup key). 0 (default) = only
# accounts that are already connected can sign in.
OIDC_AUTO_CREATE=0
# 1 = connect to an existing Inkling account with the same email, only when the provider says the email is
# verified (email_verified=true). Never for instance admins. Default 0: people connect in Settings › Account.
OIDC_LINK_EXISTING=0
# 1 = refuse sign-ins whose id_token shows no second factor (amr such as mfa/otp/hwk, or an acr from
# OIDC_ACR_VALUES). Leave 0 for providers that do not send amr/acr (Google).
OIDC_REQUIRE_MFA=0
OIDC_ACR_VALUES=
# Rarely needed: 1 = treat the provider's email as verified when it sends no email_verified claim
# (single-tenant Entra ID). Does not apply to OIDC_LINK_EXISTING.
OIDC_TRUST_EMAIL=0
# Defaults: openid email profile / RS256 (PS256 and ES256 also accepted)
OIDC_SCOPES=
OIDC_ID_TOKEN_ALG=

# --- Outgoing mail (optional) ---
# On only when both SMTP_HOST and MAIL_FROM are set. Left empty, all mail features (admin "Send by
# email", invite mail, email verification, automatic reset mail for verified accounts) are off and
# only copy-and-paste remains.
SMTP_HOST=
# Default 587 (STARTTLS). With SMTP_SECURE=1 the default is 465 (implicit TLS).
SMTP_PORT=
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
# e.g. "Inkling <no-reply@example.com>"
MAIL_FROM=
# Site address used in mail links (reset, signup, verification). Empty → PUBLIC_URL, else the request host.
# e.g. https://notes.example.com
APP_URL=
# 1: people who sign up after this is turned on cannot log in before verifying their email (not retroactive).
# Ignored when mail is off. Default 0 = only a verification banner.
REQUIRE_EMAIL_VERIFICATION=0

# --- Brute-force protection (optional; values below are the defaults) ---
# Front proxies whose X-Forwarded-For is trusted (CIDR/IP or the loopback/linklocal/uniquelocal presets).
# Default loopback,uniquelocal = a reverse proxy on the same host + the Docker bridge. false ignores XFF.
TRUST_PROXY=loopback,uniquelocal
# IPs/CIDRs that are never banned (comma-separated). e.g. 203.0.113.7,10.0.0.0/8
ALLOWLIST_IPS=
# Ban an IP when failures within the window (minutes) reach the limit. Each re-ban grows: 15 min → 1 h → 6 h → 24 h (cap).
AUTH_GUARD_WINDOW_MINUTES=15
AUTH_GUARD_MAX_FAILURES=10
AUTH_GUARD_BAN_MINUTES=15
AUTH_GUARD_BAN_MAX_HOURS=24
# Per account: never locked; past this many failures only the delay between attempts grows exponentially.
AUTH_GUARD_ACCOUNT_FAILURES=5

# Domain for HTTPS deployments (deploy/compose.caddy.yaml)
DOMAIN=

# Release of the prebuilt image ghcr.io/prove1352/inkling to run (compose.yaml), without the v:
# X.Y.Z (one exact release) or X.Y (the newest X.Y.z). Empty = latest. Only move it forward: an older release does
# not know the newer database schema (no downgrades; restore a backup instead). Ignored by source
# builds with compose.build.yaml. Upgrade steps: docs/OPERATIONS.md "Upgrades".
INKLING_VERSION=

# Default language (en|ko, default en) for emails and built-in templates of users who haven't picked one,
# and the web UI default before the browser language. Users pick their own in Settings → Language.
DEFAULT_LOCALE=

# Onboarding for new accounts: intro, Getting started checklist, sample page (docs/adr/2380-*).
# ONBOARDING=off turns it off, e.g. when your organisation has its own guide.
ONBOARDING=
# Accounts that existed before onboarding do not see the intro by themselves. ONBOARDING_EXISTING_USERS=once
# shows it to each of them once, on their next app load (checklist stays off, no sample page); who saw
# or skipped it never sees it again, also after restarts or when this is turned off (docs/adr/2383-*).
ONBOARDING_EXISTING_USERS=

# Container time zone (default UTC, e.g. Asia/Seoul). Decides "today" for due dates, daily notes,
# reminders and the times shown in emails.
TZ=

# --- Single instance (docs/adr/1925-*) ---
# The server refuses to boot while another Inkling process uses the same database. It first waits
# SINGLE_INSTANCE_WAIT seconds (default 60) for that process to stop, e.g. a replaced container that
# is still saving documents. SINGLE_INSTANCE=0 turns the guard off: never run two web servers.
SINGLE_INSTANCE=
SINGLE_INSTANCE_WAIT=

# --- Client updates (docs/OPERATIONS.md "Client updates") ---
# What an open tab does when it runs an older build than the server:
#   prompt (default) — show "A new version is available · Reload".
#   force — reload by itself once its edits are synced (falls back to the banner after 2 minutes).
UPDATE_MODE=
# Optional: compare with the latest GitHub release once a day and tell admins (Admin screen).
# Off unless UPDATE_CHECK=github. Only the repository name is sent; nothing about this instance.
UPDATE_CHECK=
UPDATE_CHECK_REPO=PROVE1352/inkling

# --- Semantic search (optional; docs/OPERATIONS.md "Semantic search", docs/adr/1740-*) ---
# Off unless EMBEDDING_URL and EMBEDDING_MODEL are both set. When on, the text of every section chunk
# (page title, heading path, chunk text) is sent to this endpoint so find_context can also rank by meaning.
# Any OpenAI-compatible /embeddings API. Inside Docker, localhost is the container: use
# http://host.docker.internal:11434/v1 or the host's LAN address for Ollama on the host.
#
# Local Ollama (nothing leaves your network; `ollama pull bge-m3` first):
# EMBEDDING_URL=http://192.168.0.10:11434/v1
# EMBEDDING_MODEL=bge-m3
#
# OpenAI (chunk text is sent to OpenAI):
# EMBEDDING_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_DIMENSIONS=512
#
# Tuning (defaults shown):
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_REQUESTS_PER_MINUTE=60
# EMBEDDING_TIMEOUT_MS=30000
# EMBEDDING_QUERY_TIMEOUT_MS=3000
# EMBEDDING_MAX_CHARS=4000
# EMBEDDING_CACHE_MB=128
#
# Role prefixes for models trained with them (e5: "query: " and "passage: "; quote to keep the space).
# Empty by default. Changing either one re-embeds every chunk, as a model change does.
# EMBEDDING_QUERY_PREFIX="query: "
# EMBEDDING_PASSAGE_PREFIX="passage: "

# --- Uploads by AI agents (MCP upload_file, API tokens posting a file; docs/adr/2065-*) ---
# People's uploads in the browser, and agents reading attachments, are not affected by any of these.
#   on    (default) agents may upload unless a workspace turns it off in Workspace settings
#   off   agents may not upload unless a workspace turns it on
#   never agents may not upload anywhere; workspaces cannot turn it on
# Any other value counts as off, with a warning at boot.
# AGENT_UPLOADS=on
# Per file, in MB (default 5, at most 64). Above 8 the MCP request limit for upload_file calls grows with
# it (base64 + 1 MB); other MCP requests stay at 12 MB. An upload in flight holds about four times the
# file in memory, so raise it only as far as you need; 0 is not "unlimited".
# AGENT_UPLOAD_MAX_MB=5
# Per account per 24 hours, in MB, over what that account's connections uploaded (default 200).
# 0 = no budget. Uploads in the browser do not count and have no budget.
# AGENT_UPLOAD_DAILY_MB=200

# --- Push notifications (web push, docs/adr/2220-*) ---
# On by default; people turn it on per device in Settings -> Notifications. Needs HTTPS (or localhost)
# and outbound HTTPS to the push services (fcm.googleapis.com, *.push.services.mozilla.com,
# *.push.apple.com, *.notify.windows.com). WEB_PUSH=off switches it off for the whole server.
# WEB_PUSH=off
# VAPID key pair (base64url, as printed by `npx web-push generate-vapid-keys`): both or neither. Unset =
# made on first use and kept in the database (sealed with APP_SECRET_KEY). Changing it voids every
# device's subscription; devices subscribe again when the app is next opened.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact sent to push services; Apple may refuse a placeholder. Default: PUBLIC_URL when it is https.
# VAPID_SUBJECT=mailto:admin@example.com
# More push service hosts (exact or *.suffix, comma-separated)
# WEB_PUSH_ALLOWED_HOSTS=

# --- Experimental features (comma-separated; off unless listed) ---
# e.g. EXPERIMENTAL_FEATURES=plugins,vault-sync,sheets-sync  — see docs/adr/0405-experimental-feature-flags.md
EXPERIMENTAL_FEATURES=
# Plugin API v0 (experimental `plugins`): directory with <id>/manifest.json + entry .js, installed by
# the operator and approved in Admin → Plugins. Default: $DATA_DIR/plugins. See docs/PLUGINS.md
PLUGINS_DIR=

# --- MCP connectors: Client ID Metadata Documents (optional; docs/adr/2280-*..2282-*) ---
# 1 = also accept apps whose OAuth client_id is an https URL of a JSON document describing them
# (claude.ai's "use Claude's published ID", Claude Code). The server then fetches that URL (public
# addresses only, no redirects, 5 KB) when someone opens a connection's consent screen. Default off;
# dynamic client registration keeps working either way.
OAUTH_CIMD=
# Only client_id URLs on these hosts (comma/space separated, exact host or *.suffix), e.g. claude.ai.
# Empty = any public https host.
OAUTH_CIMD_ALLOWED_HOSTS=

# --- Embeds / webhooks ---
# Extra https origins allowed in the SPA's CSP frame-src (space/comma separated), in addition to the
# built-in embed providers. See docs/adr/0501-embed-providers-and-frame-src.md
EMBED_EXTRA_FRAME_SRC=
# TEST ONLY: also accept http://127.0.0.1:<port>/ webhook URLs (local fake receiver). Ignored when
# NODE_ENV=production. Never set this on a real server. See docs/adr/0504-workspace-webhooks.md
WEBHOOK_TEST_ALLOW_LOOPBACK=

# --- Backups (backup sidecar in compose.yaml) — see docs/BACKUP.md ---
# 0 disables the sidecar entirely. Schedule: daily@HH:MM | hourly@MM | every@<N>m | every@<N>h | off
BACKUP_ENABLED=1
BACKUP_SCHEDULE=daily@03:00
# GFS retention: newest set of each of the last N days / ISO weeks / months
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
# Restore the newest set into a temporary database every N days and compare row counts (0 = off)
BACKUP_RESTORE_TEST_DAYS=7
# Fail early unless the backup volume has DB size + data size + this many MB free
BACKUP_MIN_FREE_MB=256
# Encrypt backup sets (openssl AES-256-CBC, PBKDF2 200k). LOSE IT AND THE BACKUPS ARE UNREADABLE —
# keep a copy outside this server (password manager / paper).
BACKUP_PASSPHRASE=
# Off-site copy with rclone, e.g. b2:my-bucket/inkling. Requires
# `-f deploy/compose.backup-rclone.yaml` and an rclone config file at BACKUP_RCLONE_CONFIG.
BACKUP_RCLONE_REMOTE=
BACKUP_RCLONE_CONFIG=./deploy/rclone.conf
